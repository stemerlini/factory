#!/usr/bin/env bash
# Build Geant4 from source into ~/.local/opt/geant4/<version>, the toolchain layout Factory's
# `geant4` module expects:  bin/geant4-config, bin/geant4.sh, share/Geant4/data (G4EMLOW,
# PhotonEvaporation, ...). Multithreaded, GDML, no GUI. EM option4 and Livermore
# (G4EmStandardPhysics_option4, G4EmLivermorePhysics) are part of every Geant4 build.
#
# Needs: cmake gcc expat xerces-c (and network access for the source and the data sets).
#   tools/build-geant4 [version]      (default: 11.4.3)
set -euo pipefail

version="${1:-11.4.3}"
src_root="$HOME/.local/src"
src="$src_root/geant4-v$version"
prefix="$HOME/.local/opt/geant4/$version"
build="$src_root/geant4-build-$version"
jobs=$(nproc)

for pkg in cmake expat xerces-c; do
  pacman -Q "$pkg" >/dev/null 2>&1 || { echo "Missing: sudo pacman -S --needed $pkg" >&2; exit 1; }
done

if [[ ! -d "$src" ]]; then
  mkdir -p "$src_root"
  tarball=$(mktemp --suffix=.tar.gz)
  curl -fL "https://gitlab.cern.ch/geant4/geant4/-/archive/v$version/geant4-v$version.tar.gz" \
    -o "$tarball"
  tar -xzf "$tarball" -C "$src_root"
  rm -f "$tarball"
fi

echo "Geant4 $version: $src -> $prefix"
cmake -S "$src" -B "$build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix" \
  -DGEANT4_BUILD_MULTITHREADED=ON -DGEANT4_USE_GDML=ON -DGEANT4_INSTALL_DATA=ON \
  -DGEANT4_USE_QT=OFF -DGEANT4_USE_OPENGL_X11=OFF -DGEANT4_BUILD_TLS_MODEL=global-dynamic
cmake --build "$build" -j "$jobs"
cmake --install "$build"

# The installer's own geant4.sh sets the library path but not the G4*DATA variables; Factory
# sources a wrapper that keeps it and exports those from `geant4-config --datasets`.
mv "$prefix/bin/geant4.sh" "$prefix/bin/geant4-install.sh"
cat > "$prefix/bin/geant4.sh" <<EOF
# Geant4 $version environment (sourced by Factory's toolchain loader)
export GEANT4_HOME="$prefix"
source "$prefix/bin/geant4-install.sh"
while read -r _ name dir; do export "\$name=\$dir"; done < <("$prefix/bin/geant4-config" --datasets)
EOF

# Every data set must be on disk and the two EM physics lists present.
source "$prefix/bin/geant4.sh"
"$prefix/bin/geant4-config" --version
"$prefix/bin/geant4-config" --datasets | while read -r _ _ dir; do
  [[ -d "$dir" ]] || { echo "Missing data set: $dir" >&2; exit 1; }
done
for l in G4EmStandardPhysics_option4 G4EmLivermorePhysics; do
  grep -rqs "$l" "$prefix/include" || { echo "Physics list $l missing" >&2; exit 1; }
done
echo "Installed Geant4 $version at $prefix; 'factory modules' checks it."
"$(dirname "${BASH_SOURCE[0]}")/build-factory-g4" "$version"
